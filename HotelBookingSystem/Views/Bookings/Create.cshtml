@model HotelBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <!--  ONLY ONE -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- USER -->
            <div class="form-group">
                <label asp-for="UserID" class="control-label"></label>
                <select asp-for="UserID" class="form-control" asp-items="ViewBag.UserID">
                    <option value="">-- Select User --</option>
                </select>
                <span asp-validation-for="UserID" class="text-danger"></span>
            </div>

            <!-- ROOM -->
            <div class="form-group">
                <label asp-for="RoomID" class="control-label"></label>
                <select asp-for="RoomID" class="form-control" asp-items="ViewBag.RoomID">
                    <option value="">-- Select Room --</option>
                </select>
                <span asp-validation-for="RoomID" class="text-danger"></span>
            </div>

            <!-- CHECK IN -->
            <div class="form-group">
                <label asp-for="CheckInDate" class="control-label"></label>
                <input asp-for="CheckInDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckInDate" class="text-danger"></span>
            </div>

            <!-- CHECK OUT -->
            <div class="form-group">
                <label asp-for="CheckOutDate" class="control-label"></label>
                <input asp-for="CheckOutDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}